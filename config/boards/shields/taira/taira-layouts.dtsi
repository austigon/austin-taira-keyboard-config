#include <physical_layouts.dtsi>

// Key positions generated from the switch footprints in the upstream Taira PCB
// (strayer/taira-keyboard, pcb/tairakb.kicad_pcb): 19 mm column pitch, 18 mm row
// pitch, thumb cluster rotated 30 degrees. Keys are listed in keymap binding order.

/ {
    taira_physical_layout: taira_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";

        keys                     //     w      h      x      y    rot     rx     ry
